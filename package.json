{
  "name": "@securecode-ai/mcp",
  "version": "0.3.5",
  "description": "Standalone SecureCode MCP server — scan, map, fix, and attack tools for AI coding assistants. Works without the VS Code extension.",
  "main": "dist/index.js",
  "bin": {
    "securecode-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p ./",
    "start": "node dist/index.js serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": [
    "dist/",
    "resources/tree-sitter/"
  ],
  "keywords": [
    "mcp",
    "security",
    "scanner",
    "vulnerability",
    "ai",
    "code-analysis",
    "securecode"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AhmedSleem06/SecureCode-mcp.git"
  },
  "homepage": "https://usesecurecode.tech",
  "bugs": {
    "url": "https://github.com/AhmedSleem06/SecureCode-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@yarnpkg/lockfile": "^1.1.0",
    "semver": "^7.5.4",
    "spdx-correct": "^3.2.0",
    "web-tree-sitter": "0.26.11",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/semver": "^7.5.6",
    "@types/spdx-correct": "^3.1.3",
    "@types/yarnpkg__lockfile": "^1.1.9",
    "typescript": "^5.3.2",
    "vitest": "^2.1.0"
  }
}
