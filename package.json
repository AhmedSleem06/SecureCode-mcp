{
  "name": "@securecode-ai/mcp",
  "version": "0.13.0",
  "description": "Standalone SecureCode MCP server: an AI security investigator for AI coding assistants that proves findings with sandbox tests, plus secrets and dependency checks and verified fixes.",
  "main": "dist/index.js",
  "bin": {
    "securecode-mcp": "dist/index.js"
  },
  "icon": "icon.svg",
  "scripts": {
    "build": "tsc -p ./ && node -e \"require('fs').mkdirSync('dist/assurance/harness',{recursive:true});require('fs').copyFileSync('src/assurance/harness/expressRunner.cjs','dist/assurance/harness/expressRunner.cjs')\"",
    "start": "node dist/index.js serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build && npm test"
  },
  "files": [
    "dist/",
    "resources/tree-sitter/",
    "icon.svg"
  ],
  "keywords": [
    "mcp",
    "security",
    "scanner",
    "vulnerability",
    "ai",
    "code-analysis",
    "securecode"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AhmedSleem06/SecureCode-mcp.git"
  },
  "homepage": "https://usesecurecode.tech",
  "bugs": {
    "url": "https://github.com/AhmedSleem06/SecureCode-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@yarnpkg/lockfile": "^1.1.0",
    "esbuild": "^0.28.2",
    "semver": "^7.5.4",
    "spdx-correct": "^3.2.0",
    "web-tree-sitter": "0.26.11",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/semver": "^7.5.6",
    "@types/spdx-correct": "^3.1.3",
    "@types/yarnpkg__lockfile": "^1.1.9",
    "express4": "npm:express@^4.22.3",
    "express5": "npm:express@^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "typescript": "^5.3.2",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true
  }
}
